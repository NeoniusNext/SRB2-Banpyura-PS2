 	}
-	for (x = 0; x < c.W2; x++)
-		dst[x] = s[src_col(&c, x)];
+	remaining = c.W2;
+	if (!remaining)
+		return;
+	const u32 step = 1u << c.dx;
+	u32 sx = step >> 1;
+	// One sample body; the final unused unsigned/cursor advances perform no access.
