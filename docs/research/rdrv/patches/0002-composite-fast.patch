+#ifdef PS2_PROFILE
+// OPT13 RDRV: composition in column order. The posts of a Doom patch are columns and the block is row-major: the fast path above writes every texel of a post to another row
+// (banded by 64 rows, which makes the walk of the posts repeat for every band: a 64 x 1536 pipe walks them 24 times, 33 cycles per texel measured). Here the posts are copied
+// as they are into a scratch in column order (x * height + y: one memcpy per post, sequential), and the scratch is turned into the row-major block in 16 x 16 tiles once.
+// The same texels as the fast path (same clipping), for textures whose patches are all plain copies (AST_COPY, no vertical flip) in a P_8 block without a colormap.
+static boolean HWR_ColMajorOK(const GLMipmap_t *mipmap, const texture_t *texture)
+{
+	INT32 i;
+
+	if (ps2hwt_comp_old || ps2_slow_composite || format2bpp(mipmap->format) != 1 || mipmap->colormap)
+		return false;
+	for (i = 0; i < texture->patchcount; i++)
+		if (texture->patches[i].style != AST_COPY || (texture->patches[i].flip & 2))
+			return false;
+	return true;
+}
+
+static void HWR_DrawPatchColMajor(UINT8 *cm, INT32 pblockwidth, INT32 pblockheight, const texture_t *texture, const texpatch_t *patch, const patch_t *realpatch)
+{
+	INT32 x, x1, x2, col, ncols, sx0, j;
+	const INT32 width = realpatch->width, height = realpatch->height, originy = patch->originy;
+
+	if (texture->width <= 0 || texture->height <= 0)
+		return;
+	x1 = patch->originx;
+	x2 = x1 + width;
+	if (x1 > texture->width || x2 < 0)
+		return;
+	if (originy > texture->height || (originy + height) < 0)
+		return;
+	x = x1 < 0 ? 0 : x1;
+	if (x2 > texture->width)
+		x2 = texture->width;
+	col = x * pblockwidth / texture->width;
+	ncols = ((x2 - x) * pblockwidth) / texture->width;
+	sx0 = x1 < 0 ? -x1 : 0;
+	for (j = 0; j < ncols; j++)
+	{
+		const column_t *pc = (patch->flip & 1) ? &realpatch->columns[(width - 1) - (sx0 + j)] : &realpatch->columns[sx0 + j];
+		UINT8 *dcol = cm + (size_t)(col + j) * (size_t)pblockheight;
+		unsigned i;
+
+		for (i = 0; i < pc->num_posts; i++)
+		{
+			const post_t *post = &pc->posts[i];
+			INT32 position = originy + (INT32)post->topdelta, count = (INT32)post->length, srcoff = 0;
+			const UINT8 *src;
+
+			if (position < 0)
+			{
+				srcoff = -position;
+				count += position;
+				position = 0;
+			}
+			if (position + count > pblockheight)
+				count = pblockheight - position;
+			if (count <= 0)
+				continue;
+			src = pc->pixels + post->data_offset + srcoff;
+			if (count >= 32)
+				memcpy(dcol + position, src, (size_t)count);
+			else
+			{
+				UINT8 *d = dcol + position;
+
+				while (count--)
+					*d++ = *src++;
+			}
+		}
+	}
+}
+
+// dst[y * W + x] = cm[x * H + y], in tiles of 16 x 16
+static void HWR_TransposeBlock(UINT8 *dst, const UINT8 *cm, INT32 W, INT32 H)
+{
+	INT32 x0, y0, x, y;
+
+	for (y0 = 0; y0 < H; y0 += 16)
+	{
+		const INT32 yn = H - y0 < 16 ? H - y0 : 16;
+
+		for (x0 = 0; x0 < W; x0 += 16)
+		{
+			const INT32 xn = W - x0 < 16 ? W - x0 : 16;
+
+			for (x = 0; x < xn; x++)
+			{
+				const UINT8 *sp = cm + (size_t)(x0 + x) * (size_t)H + y0;
+				UINT8 *dp = dst + (size_t)y0 * (size_t)W + x0 + x;
+
+				for (y = 0; y < yn; y++, dp += W)
+					*dp = sp[y];
+			}
+		}
+	}
+}
