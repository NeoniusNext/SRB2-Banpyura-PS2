+// A subsector's flat planes have the same points and view planes; only d0 = b*h+d
+// changes. Cache answers to each side test for this one HWR_Subsector call:
+// all q[i]+d0 > margin stays true as d0 increases, and an inside witness stays
+// inside as d0 decreases. Keep the original arithmetic and margin. This does
+// not reject any additional plane or alter texture/planner/draw-node traffic.
+// The caller clears the two masks for every subsector, including every view.
+typedef struct
+{
+	float in[5], out[5];
+	unsigned int inside, outside;
+} fr_heightcache_t;
+
+static inline int HWR_FrPlaneHiddenCached(const polyvertex_t *pts, int n, float h, fr_heightcache_t *cache)
+{
+	int k;
+
+	for (k = 0; k < 5; k++)
+	{
+		const fr_plane_t *pl = &frv.p[k];
+		const float d0 = pl->b * h + pl->d;
+		const unsigned int bit = 1u << k;
+		const int finite = d0 >= -FLT_MAX && d0 <= FLT_MAX;
+		int i;
+
+		// Nonfinite thresholds never enter the cache: in particular, an
+		// infinite addend can turn a vertex's opposite infinity into NaN.
+		if (finite && (cache->outside & bit) && d0 >= cache->out[k])
+			return 1;
+		if (finite && (cache->inside & bit) && d0 <= cache->in[k])
+			continue;
+		for (i = 0; i < n; i++)
+			if (pl->a * pts[i].x + pl->c * pts[i].y + d0 <= FR_MARGIN)
+			{
+				if (finite && (!(cache->inside & bit) || d0 > cache->in[k]))
+				{
+					cache->in[k] = d0;
+					cache->inside |= bit;
+				}
+				goto inside;
+			}
+		if (finite && (!(cache->outside & bit) || d0 < cache->out[k]))
+		{
+			cache->out[k] = d0;
+			cache->outside |= bit;
+		}
+		return 1;
+inside:;
+	}
+	return 0;
+}
