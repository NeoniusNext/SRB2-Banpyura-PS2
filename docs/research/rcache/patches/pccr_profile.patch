diff --git a/src/ps2/ps2_prof.h b/src/ps2/ps2_prof.h
index 55901fc..9ff5ff5 100644
--- a/src/ps2/ps2_prof.h
+++ b/src/ps2/ps2_prof.h
@@ -41,6 +41,14 @@ void PS2Prof_FrameEnd(void); // frame counter of LTO profile builds (called from
 // after the display; the rest of the frame is "other" (idle wait, sleep). realtics = what the clock asked for, gametic delta = what ran: lost tics.
 extern UINT64 ps2prof_c_tick, ps2prof_c_disp, ps2prof_c_snd;
 extern UINT32 ps2prof_real;
+// OPT13-RCACHE: R5900 performance counters (PCCR). -ps2pccr [E0 E1]: counter 0 counts event E0 (default 6 = instruction cache miss), counter 1 event E1 (default 6 = data cache miss);
+// the numbers are the EE Core User's Manual's, tools/.../bench/cachebench.c (CB pccr) finds them empirically on a console. PCSX2 counts neither (zeros). Misses summed per window over
+// TryRunTics (tick), D_Display (render + HUD + present) and the sound step: PROFPC line next to TICK.
+extern UINT32 ps2prof_pccr_on;
+extern UINT64 ps2prof_pc_i[3], ps2prof_pc_d[3]; // [0] tick, [1] disp, [2] snd
+static inline UINT32 PS2Prof_Pc0(void) { UINT32 v; __asm__ volatile("mfpc %0,0" : "=r"(v)); return v; }
+static inline UINT32 PS2Prof_Pc1(void) { UINT32 v; __asm__ volatile("mfpc %0,1" : "=r"(v)); return v; }
+void PS2Prof_PccrInit(void);
 static inline UINT32 PS2Prof_Cyc(void) { UINT32 v; __asm__ volatile("mfc0 %0,$9" : "=r"(v)); return v; }
 #endif
 
