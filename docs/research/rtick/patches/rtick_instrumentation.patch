+static void rt_pct(unsigned long *v, unsigned n, double *p50, double *p90, double *p99, double *mx)
+{
+	unsigned long *c = malloc(n * sizeof *c);
+	unsigned i, j;
+	for (i = 0; i < n; i++) c[i] = v[i];
+	for (i = 1; i < n; i++) { unsigned long x = c[i]; for (j = i; j > 0 && c[j-1] > x; j--) c[j] = c[j-1]; c[j] = x; }
+	*p50 = c[n/2]; *p90 = c[n*9/10]; *p99 = c[n*99/100]; *mx = c[n-1];
+	free(c);
+}
