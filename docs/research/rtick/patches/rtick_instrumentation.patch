+void RT_PairBegin(mobj_t *mo, int site)
+{
+	rt_ps.before = *mo;
+	rt_ps.seed = P_GetRandSeed();
+	rt_ps.drpoff = RT_GetDrpoff();
+	rt_ps.lines = rt.cp_lines_called; rt_ps.lines_bbox = rt.cp_lines_bbox; rt_ps.lines_hit = rt.cp_lines_hit;
+	rt_ps.things = rt.cp_things_called; rt_ps.things_pass = rt.cp_things_pass; rt_ps.cells = rt.cp_cells_t + rt.cp_cells_l;
+	rt_ps.valid = true;
+	rt_ps.pred = 0;
+	{
+		rt_memo_t *me = &rt_memo[(((size_t)mo) >> 4) & 0x7FFF];
+		rt_ptype_t *t = &rt.ptype[mo->type < RT_MAXT ? mo->type : 0];
+		rt_key_t k;
+		rt_key_of(mo, &k);
+		if (me->mo != mo || !me->valid) t->memo_miss_first++;
+		else if (memcmp(&k, &me->key, sizeof k)) t->memo_miss_key++;
+		else if (rt_secsig_of(mo) > me->secsig && 0) t->memo_miss_sec++;
+		else
+		{
+			UINT32 ss = rt_secsig_of(mo), cs = rt_cellsum_of(mo);
+			if (ss != me->secsig) t->memo_miss_sec++;
+			else if (cs != me->cellsum) t->memo_miss_cell++;
+			else if (rt_polysig_of(mo) != me->polyep) t->memo_miss_poly++;
+			else rt_ps.pred = 1;
+		}
+	}
+	if (site == 1) rt.pair_m++; else rt.pair_s++;
+}
