+static inline int rt_m_keydiff_w(const void *a, const void *b, size_t n)
+{
+	const UINT8 *pa = (const UINT8 *)a, *pb = (const UINT8 *)b;
+	size_t i = 0;
+	for (; i + 16 <= n; i += 16)
+	{
+		UINT64 x0, x1, y0, y1;
+		memcpy(&x0, pa + i, 8); memcpy(&x1, pa + i + 8, 8); memcpy(&y0, pb + i, 8); memcpy(&y1, pb + i + 8, 8);
+		if ((x0 ^ y0) | (x1 ^ y1)) return 1;
+	}
+	for (; i < n; i++) if (pa[i] != pb[i]) return 1;
+	return 0;
+}
