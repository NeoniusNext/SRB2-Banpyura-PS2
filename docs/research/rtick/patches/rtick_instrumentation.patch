diff --git a/src/rt_memo.h b/src/rt_memo.h
new file mode 100644
index 0000000..823fadd
--- /dev/null
+++ b/src/rt_memo.h
@@ -0,0 +1,29 @@
+// RTICK research prototype (host profile, -DRT_MEMO_SHADOW / -DRT_MEMO_LIVE). NOT product code; kept as a patch in docs/research/rtick/patches.
+//
+// "Pair memo": a ZMovement + CheckPosition pair of an object that last time changed nothing (mobj, RNG, tmdrpoffceilz, no XY-overlapping thing in its cells) is skipped
+// while every input of the pair is provably the same:
+//   (1) the object's own key (hash of the ~35 fields the pair reads),
+//   (2) the "signature" of every sector the object touches (heights, slopes, FOF flags/control heights, sector flags/damagetype/gravity/...): a generation number per
+//       sector, advanced when a scan at the start of the tic (prototype) or a writer hook (product) sees a change,
+//   (3) the version of every blockmap cell the object's box covers (advanced by every link/unlink of a thing there),
+//   (4) the change tic of every polyobject whose block box meets the object's cells (or that sits in the object's subsector).
+// RT_MEMO_SHADOW: the pair always runs; when the memo predicts "no change" the whole mobj, the RNG and tmdrpoffceilz are compared afterwards (I_Error on any difference).
+// RT_MEMO_LIVE: the pair is skipped when the memo predicts "no change".
+#ifndef __RT_MEMO_H__
+#define __RT_MEMO_H__
+#if defined(RT_MEMO_SHADOW) || defined(RT_MEMO_LIVE)
+#define RT_MEMO 1
+#if defined(RT_MEMO_BLOCK) && !defined(RT_REORDER_KEY)
+#error RT_MEMO_BLOCK needs RT_REORDER_KEY (the key fields contiguous)
+#endif
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+extern UINT32 rt_memo_things_pass; // PIT_DoCheckThing: things whose boxes overlap in x/y
+extern UINT32 rt_memo_now;
+void RT_MemoTickStart(void);
+void RT_MemoCellVer(int cell);
+fixed_t RT_MemoGetDrpoff(void);
+#endif
+#endif
