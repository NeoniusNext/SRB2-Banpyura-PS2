+static UINT32 rt_m_polysig(const mobj_t *m)
+{
+	// polyobjects the pair can see: those linked into the cells of the box (the loop of P_CheckPosition) and those in the subsector's polyList.
+	// The signature is a hash over (index, generation) of every link, not a maximum: a polyobject that leaves the cells must change it.
+	extern polyobj_t *PolyObjects;
+	extern INT32 numPolyObjects;
+	UINT32 sig = 0;
+	INT32 xl, xh, yl, yh, bx, by;
+	polyobj_t *po;
+	if (!numPolyObjects || !rt_m_polygen) return 0;
+	if (PS2_HAVE_POLYBLOCKS)
+	{
+		xl = (unsigned)(m->x - m->radius - bmaporgx)>>MAPBLOCKSHIFT; xh = (unsigned)(m->x + m->radius - bmaporgx)>>MAPBLOCKSHIFT;
+		yl = (unsigned)(m->y - m->radius - bmaporgy)>>MAPBLOCKSHIFT; yh = (unsigned)(m->y + m->radius - bmaporgy)>>MAPBLOCKSHIFT;
+		if (xh >= bmapwidth) xh = bmapwidth - 1;
+		if (yh >= bmapheight) yh = bmapheight - 1;
+		for (by = yl; by <= yh; by++)
+			for (bx = xl; bx <= xh; bx++)
+			{
+				polymaplink_t *plink;
+				for (plink = POLYBLOCKLINK((size_t)by * bmapwidth + bx); plink; plink = (polymaplink_t *)(plink->link.next))
+					sig = sig * 31u + rt_m_polygen[plink->po - PolyObjects] + (UINT32)(plink->po - PolyObjects) * 65537u + 1u;
+			}
+	}
+	if (m->subsector)
+		for (po = m->subsector->polyList; po; po = (polyobj_t *)(po->link.next))
+			sig = sig * 37u + rt_m_polygen[po - PolyObjects] + (UINT32)(po - PolyObjects) * 65537u + 7u;
+	return sig;
+}
