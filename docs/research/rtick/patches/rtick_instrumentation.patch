+	const UINT32 w[] = {
+		(UINT32)m->x, (UINT32)m->y, (UINT32)m->z, (UINT32)m->momx, (UINT32)m->momy, (UINT32)m->momz, (UINT32)m->pmomz, (UINT32)m->radius, (UINT32)m->height,
