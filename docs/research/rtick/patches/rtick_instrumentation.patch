+static UINT32 rt_m_secsig(const mobj_t *m)
+{
+	UINT32 mx = 0;
+	msecnode_t *n;
+	if (m->subsector) { UINT32 g = rt_m_secgen[m->subsector->sector - sectors]; if (g > mx) mx = g; }
+	if (!(m->flags & MF_NOCLIP))
+		for (n = m->touching_sectorlist; n; n = n->m_sectorlist_next) { UINT32 g = rt_m_secgen[n->m_sector - sectors]; if (g > mx) mx = g; }
