+static void rt_key_of(const mobj_t *m, rt_key_t *k)
+{
+	memset(k, 0, sizeof *k);
+	k->x = m->x; k->y = m->y; k->z = m->z; k->momx = m->momx; k->momy = m->momy; k->momz = m->momz; k->pmomz = m->pmomz; k->radius = m->radius; k->height = m->height;
+	k->floorz = m->floorz; k->ceilingz = m->ceilingz; k->scale = m->scale; k->destscale = m->destscale; k->flags = m->flags; k->flags2 = m->flags2; k->eflags = m->eflags;
