+// ---- memo simulator: what share of the pair calls could be skipped if every input of the pair were versioned (sector signature scan, cell versions, polyobject epoch, own key)
+typedef struct { fixed_t x, y, z, momx, momy, momz, pmomz, radius, height, floorz, ceilingz, scale, destscale; UINT32 flags, flags2; UINT32 eflags; INT32 type, health, fuse;
+	void *standingslope, *target, *subsector, *floorrover, *ceilingrover, *tracer; } rt_key_t;
+typedef struct { void *mo; int valid; rt_key_t key; UINT32 secsig, cellsum, polyep; } rt_memo_t;
+static rt_memo_t rt_memo[1<<15];
+static UINT32 *rt_sec_chg;
+static UINT32 *rt_cellver;
+static UINT32 rt_polyep = 1;
+static UINT32 *rt_poly_chg; static UINT32 *rt_poly_prev;
+static UINT32 rt_now = 1;
+typedef struct { fixed_t f, c; void *fs, *cs; fixed_t fsv[6], csv[6]; UINT32 ffh, misc; } rt_secsig_t;
+static rt_secsig_t *rt_sec_prev;
+static UINT32 rt_polyh_prev;
+unsigned long rt_geom_ticks_changed, rt_geom_sectors_changed_total;
+static unsigned long *rt_sec_nchg;
+
+static void rt_slopesig(pslope_t *sl, fixed_t *v)
+{
+	if (!sl) { memset(v, 0, 6 * sizeof(fixed_t)); return; }
+	v[0] = sl->o.x; v[1] = sl->o.y; v[2] = sl->o.z; v[3] = sl->normal.x; v[4] = sl->normal.y; v[5] = sl->normal.z;
+}
+
+static void rt_calc_secsig(size_t i, rt_secsig_t *g)
+{
+	sector_t *sc = &sectors[i];
+	ffloor_t *r;
+	memset(g, 0, sizeof *g);
+	g->f = sc->floorheight; g->c = sc->ceilingheight; g->fs = sc->f_slope; g->cs = sc->c_slope;
+	rt_slopesig(sc->f_slope, g->fsv); rt_slopesig(sc->c_slope, g->csv);
+	g->misc = (UINT32)sc->flags * 31u + (UINT32)sc->damagetype * 131u + (UINT32)sc->special * 7u + (UINT32)sc->heightsec + (UINT32)sc->gravity;
+	for (r = sc->ffloors; r; r = r->next)
+	{
+		sector_t *cs = &sectors[r->secnum];
+		fixed_t v1[6], v2[6];
+		UINT32 h = (UINT32)r->fofflags * 2654435761u;
+		h ^= (UINT32)cs->floorheight * 40503u; h ^= (UINT32)cs->ceilingheight * 9973u;
+		rt_slopesig(r->t_slope ? *r->t_slope : NULL, v1); rt_slopesig(r->b_slope ? *r->b_slope : NULL, v2);
+		{ int k; for (k = 0; k < 6; k++) { h = h * 31u + (UINT32)v1[k]; h = h * 31u + (UINT32)v2[k]; } }
+		h ^= (UINT32)(size_t)r->t_slope + (UINT32)(size_t)r->b_slope;
+		g->ffh = g->ffh * 17u + h;
+	}
+}
+
+void RT_GeomScan(void)
+{
+	size_t i;
+	UINT32 ph = 0;
+	int nch = 0;
+	extern polyobj_t *PolyObjects;
+	extern INT32 numPolyObjects;
+	rt_now++;
+	if (!rt_sec_prev || !rt_sec_chg)
+	{
+		rt_sec_prev = calloc(numsectors, sizeof *rt_sec_prev);
+		rt_sec_chg = calloc(numsectors, sizeof *rt_sec_chg);
+		rt_sec_nchg = calloc(numsectors, sizeof *rt_sec_nchg);
+		for (i = 0; i < numsectors; i++) rt_calc_secsig(i, &rt_sec_prev[i]);
+		rt_cellver = calloc((size_t)bmapwidth * bmapheight + 1, sizeof *rt_cellver);
+	}
+	for (i = 0; i < numsectors; i++)
+	{
+		rt_secsig_t g;
+		rt_calc_secsig(i, &g);
+		if (memcmp(&g, &rt_sec_prev[i], sizeof g))
+		{
+			rt_sec_prev[i] = g;
+			rt_sec_chg[i] = rt_now;
+			rt_sec_nchg[i]++;
+			nch++;
+		}
+	}
+	if (numPolyObjects && !rt_poly_chg) { rt_poly_chg = calloc(numPolyObjects, sizeof(UINT32)); rt_poly_prev = calloc(numPolyObjects, sizeof(UINT32)); }
+	for (i = 0; i < (size_t)numPolyObjects; i++)
+	{
+		polyobj_t *po = &PolyObjects[i];
+		UINT32 h = (UINT32)po->centerPt.x * 31u + (UINT32)po->centerPt.y * 7u + (UINT32)po->angle + (UINT32)po->flags + (UINT32)po->blockbox[0] * 13u + (UINT32)po->blockbox[1] + (UINT32)po->blockbox[2] * 5u + (UINT32)po->blockbox[3] * 3u;
+		if (h != rt_poly_prev[i]) { rt_poly_prev[i] = h; rt_poly_chg[i] = rt_now; }
+		ph += h;
+	}
+	if (ph != rt_polyh_prev) { rt_polyh_prev = ph; rt_polyep = rt_now; }
+	if (nch) rt_geom_ticks_changed++;
+	rt_geom_sectors_changed_total += nch;
+}
