+static UINT32 rt_polysig_of(const mobj_t *m)
+{
+	extern polyobj_t *PolyObjects;
+	extern INT32 numPolyObjects;
+	UINT32 mx = 0;
+	INT32 i, xl, xh, yl, yh;
+	polyobj_t *po;
+	if (!numPolyObjects || !rt_poly_chg)
+		return 0;
+	xl = (unsigned)(m->x - m->radius - bmaporgx)>>MAPBLOCKSHIFT; xh = (unsigned)(m->x + m->radius - bmaporgx)>>MAPBLOCKSHIFT;
+	yl = (unsigned)(m->y - m->radius - bmaporgy)>>MAPBLOCKSHIFT; yh = (unsigned)(m->y + m->radius - bmaporgy)>>MAPBLOCKSHIFT;
+	for (i = 0; i < numPolyObjects; i++)
+	{
+		const fixed_t *bb = PolyObjects[i].blockbox;
+		// blockbox is in blockmap cells in SRB2 (see Polyobj_getBlockbox): BOXTOP, BOXBOTTOM, BOXLEFT, BOXRIGHT
+		if (xh >= (INT32)bb[BOXLEFT] && xl <= (INT32)bb[BOXRIGHT] && yh >= (INT32)bb[BOXBOTTOM] && yl <= (INT32)bb[BOXTOP])
+			if (rt_poly_chg[i] > mx) mx = rt_poly_chg[i];
+	}
+	if (m->subsector)
+		for (po = m->subsector->polyList; po; po = (polyobj_t *)(po->link.next))
+			if (rt_poly_chg[po - PolyObjects] > mx) mx = rt_poly_chg[po - PolyObjects];
+	return mx;
+}
+
+static UINT32 rt_secsig_of(const mobj_t *m)
+{
+	UINT32 mx = 0;
+	msecnode_t *n;
+	if (m->subsector && rt_sec_chg)
+	{
+		size_t si = (size_t)(m->subsector->sector - sectors);
+		if (rt_sec_chg[si] > mx) mx = rt_sec_chg[si];
+	}
+	if (!(m->flags & MF_NOCLIP) && rt_sec_chg)
+		for (n = m->touching_sectorlist; n; n = n->m_sectorlist_next)
+		{
+			size_t si = (size_t)(n->m_sector - sectors);
+			if (rt_sec_chg[si] > mx) mx = rt_sec_chg[si];
+		}
+	return mx;
+}
+
+static UINT32 rt_cellsum_of(const mobj_t *m)
+{
+	INT32 xl, xh, yl, yh, bx, by;
+	UINT32 sum = 0;
+	if ((m->flags & MF_NOCLIP) || !rt_cellver) return 0;
+	xl = (unsigned)(m->x - m->radius - bmaporgx)>>MAPBLOCKSHIFT; xh = (unsigned)(m->x + m->radius - bmaporgx)>>MAPBLOCKSHIFT;
+	yl = (unsigned)(m->y - m->radius - bmaporgy)>>MAPBLOCKSHIFT; yh = (unsigned)(m->y + m->radius - bmaporgy)>>MAPBLOCKSHIFT;
+	for (bx = xl; bx <= xh; bx++) for (by = yl; by <= yh; by++)
+		if (bx >= 0 && by >= 0 && bx < bmapwidth && by < bmapheight) sum = sum * 3u + rt_cellver[by * bmapwidth + bx] + 1u;
+	return sum;
+}
