+	unsigned long memo_pred, memo_viol, memo_miss_first, memo_miss_key, memo_miss_sec, memo_miss_cell, memo_miss_poly, memo_miss_prevchange;
+} rt_ptype_t;
+
+typedef struct
+{
+	unsigned long tick_calls[8];       // 0 mobj thinker entries, 1 NOTHINK, 2 scenery quick, 3 scenery(full) , 4 regular, 5 dead, 6 pushable, 7 boss
+	unsigned long scen_thinker;        // P_SceneryThinker (called via P_MobjSceneryThink)
+	unsigned long pair_m, pair_s;
+	unsigned long cp_site[8];
+	unsigned long cp_total, cp_lines_called, cp_lines_bbox, cp_lines_hit, cp_things_called, cp_things_pass, cp_cells_t, cp_cells_l;
+	unsigned long setpos, setpos_same_xyr, setpos_same_sector_xy;
+	unsigned long unsetpos;
+	unsigned long secnode_calls, secnode_lines;
+	rt_ptype_t ptype[RT_MAXT];
+	unsigned long setpos_type[RT_MAXT], setpos_same_type[RT_MAXT];
+	unsigned long tickn;
+	unsigned long per_tick_pairs[1200], per_tick_cp[1200], per_tick_lines[1200], per_tick_setpos[1200], per_tick_things[1200];
+	int site;
+} rt_stats_t;
